{
  "get_weather": {
    "type": "function",
    "function": {
      "name": "get_weather",
      "description": "Get the observed or forecast weather for a city on a specific date.",
      "parameters": {
        "type": "object",
        "properties": {
          "city": {"type": "string", "description": "City name"},
          "date": {"type": "string", "description": "ISO date YYYY-MM-DD"}
        },
        "required": ["city", "date"],
        "additionalProperties": false
      }
    }
  },
