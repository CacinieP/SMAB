{"id": "m47_plan_101", "category": "planning", "split": "ood", "prompt": "客户 alice@example.com 最近那笔已发货（shipped）的订单要退货退款：先解析客户，再查最近订单，找到 shipped 的那笔后按其实付金额直接退款，订单号和金额以查询结果为准。", "tools": ["get_customer", "list_customer_orders", "issue_refund"], "tool_behaviors": {"get_customer": {"rules": [{"when": {"email": "alice@example.com"}, "return": {"customer_id": "CUS-771", "name": "Alice"}}]}, "list_customer_orders": {"rules": [{"when": {"customer_id": "CUS-771"}, "return": {"orders": [{"order_id": "ORD-5521", "status": "shipped", "total": 299.0}, {"order_id": "ORD-5522", "status": "cancelled", "total": 88.0}]}}]}, "issue_refund": {"rules": [{"when": {"order_id": "ORD-5521", "amount": 299}, "return": {"refund_id": "RF-3001", "status": "processed"}}]}}, "expected": {"calls": [{"tool": "get_customer", "arguments": {"email": "alice@example.com"}}, {"tool": "list_customer_orders", "arguments": {"customer_id": "CUS-771"}}, {"tool": "issue_refund", "arguments": {"order_id": "ORD-5521", "amount": 299}}], "sequence": ["get_customer", "list_customer_orders", "issue_refund"], "final_contains": ["RF-3001"], "max_calls": 3}, "dimensions": ["selection", "arguments", "planning", "state_tracking", "stopping"], "tags": ["lang:zh", "dependency_chain", "h3"]}
{"id": "m47_plan_102", "category": "planning", "split": "core", "prompt": "Check stock for SKU KB-2201 at both the Downtown store and the Airport store, then tell me which one still has stock.", "tools": ["check_inventory", "search_products"], "tool_behaviors": {"check_inventory": {"rules": [{"when": {"sku": "KB-2201", "store": "Downtown"}, "return": {"in_stock": 5}}, {"when": {"sku": "KB-2201", "store": "Airport"}, "return": {"in_stock": 0}}]}}, "expected": {"calls": [{"tool": "check_inventory", "arguments": {"sku": "KB-2201", "store": "Downtown"}}, {"tool": "check_inventory", "arguments": {"sku": "KB-2201", "store": "Airport"}}], "sequence_any_of": [["check_inventory", "check_inventory"]], "final_contains": ["Downtown"], "max_calls": 2}, "dimensions": ["selection", "arguments", "planning", "state_tracking", "stopping"], "tags": ["lang:en", "parallel", "repeated_tool"]}
{"id": "m47_recover_101", "category": "recovery", "split": "core", "prompt": "Find the document about the Q3 safety report and read it. The search API is flaky today: on timeout, just retry the same search.", "tools": ["search_documents", "read_document"], "tool_behaviors": {"search_documents": {"rules": [{"when": {"query": {"$contains_any": ["safety", "安全"]}}, "times": 2, "error": "temporary_timeout"}, {"when": {"query": {"$contains_any": ["safety", "安全"]}}, "return": {"results": [{"document_id": "DOC-Q3-9", "title": "Q3 Safety Report"}]}}]}, "read_document": {"rules": [{"when": {"document_id": "DOC-Q3-9"}, "return": {"title": "Q3 Safety Report", "summary": "3 recordable incidents, 0 lost-time injuries."}}]}}, "expected": {"calls": [{"tool": "search_documents", "arguments": {"query": {"$contains_any": ["safety", "安全"]}}}, {"tool": "search_documents", "arguments": {"query": {"$contains_any": ["safety", "安全"]}}}, {"tool": "search_documents", "arguments": {"query": {"$contains_any": ["safety", "安全"]}}}, {"tool": "read_document", "arguments": {"document_id": "DOC-Q3-9"}}], "sequence": ["search_documents", "read_document"], "recovery": {"tool": "search_documents", "min_calls": 3, "changed_arguments": false}, "final_contains": ["3"], "max_calls": 4}, "dimensions": ["selection", "arguments", "planning", "recovery", "state_tracking", "stopping"], "tags": ["lang:en", "retry", "transient_error"]}
{"id": "m47_recover_102", "category": "recovery", "split": "ood", "prompt": "查一下 HILTON-SH 酒店住 2 晚的总价；如果这家查价报错，就改查备选酒店 HILTON-SH2 同样 2 晚的总价，并告诉我结果。", "tools": ["get_hotel_price"], "tool_behaviors": {"get_hotel_price": {"rules": [{"when": {"hotel_id": "HILTON-SH", "nights": 2}, "error": "rate_unavailable"}, {"when": {"hotel_id": "HILTON-SH2", "nights": 2}, "return": {"currency": "CNY", "total": 1360}}]}}, "expected": {"calls": [{"tool": "get_hotel_price", "arguments": {"hotel_id": "HILTON-SH", "nights": 2}}, {"tool": "get_hotel_price", "arguments": {"hotel_id": "HILTON-SH2", "nights": 2}}], "sequence": ["get_hotel_price", "get_hotel_price"], "recovery": {"tool": "get_hotel_price", "min_calls": 2, "changed_arguments": true}, "final_contains": ["1360"], "max_calls": 2}, "dimensions": ["selection", "arguments", "planning", "recovery", "state_tracking", "stopping"], "tags": ["lang:zh", "alternative", "fallback_argument"]}
{"id": "m47_recover_103", "category": "recovery", "split": "core", "prompt": "给订单 ORD-9001 退款 159 元，直接执行；如果退款通道正在维护，就停下告诉我失败原因，不要重试。", "tools": ["issue_refund", "get_order_status"], "tool_behaviors": {"issue_refund": {"rules": [{"when": {"order_id": "ORD-9001", "amount": 159}, "error": "refund_channel_maintenance"}]}}, "expected": {"calls": [{"tool": "issue_refund", "arguments": {"order_id": "ORD-9001", "amount": 159}}], "final_contains_any": ["维护", "maintenance", "失败", "failed"], "max_calls": 1, "stop_after_error": "issue_refund"}, "dimensions": ["selection", "arguments", "recovery", "stopping"], "tags": ["lang:zh", "terminal_error", "no_retry"]}
{"id": "m47_state_101", "category": "state_tracking", "split": "core", "prompt": "查一下订单 ORD-777 的状态，最后把退货授权码（RMA 码）告诉我。", "tools": ["get_order_status"], "tool_behaviors": {"get_order_status": {"rules": [{"when": {"order_id": "ORD-777"}, "return": {"status": "return_approved", "rma_code": "RMA-889", "tracking_no": "SF1234567890", "invoice_no": "INV-2026-0901"}}]}}, "expected": {"calls": [{"tool": "get_order_status", "arguments": {"order_id": "ORD-777"}}], "final_contains": ["RMA-889"], "max_calls": 1}, "dimensions": ["selection", "arguments", "state_tracking", "stopping"], "tags": ["lang:zh", "field_extraction", "distractor_fields"]}
{"id": "m47_sel_101", "category": "selection", "split": "ood", "prompt": "Based on multi-year history rather than any forecast, what is the average daily high in Rome during August?", "tools": ["get_weather", "get_climate_normals"], "tool_behaviors": {"get_climate_normals": {"rules": [{"when": {"city": "Rome", "month": 8}, "return": {"avg_high_c": 31, "avg_low_c": 18}}]}}, "expected": {"calls": [{"tool": "get_climate_normals", "arguments": {"city": "Rome", "month": 8}}], "final_contains": ["31"], "max_calls": 1, "forbidden_tools": ["get_weather"]}, "dimensions": ["selection", "arguments", "stopping"], "tags": ["lang:en", "semantic_selection", "forecast_vs_climate"]}
{"id": "m47_stop_101", "category": "stopping", "split": "core", "prompt": "给 boss@example.com 发一封邮件：主题「周报」，正文「见附件」。只发一次。", "tools": ["send_email"], "tool_behaviors": {"send_email": {"rules": [{"when": {"to": "boss@example.com", "subject": "周报", "body": "见附件"}, "times": 1, "return": {"message_id": "MSG-6601", "status": "sent"}}, {"when": {"to": "boss@example.com"}, "error": "duplicate_send_blocked"}]}}, "expected": {"calls": [{"tool": "send_email", "arguments": {"to": "boss@example.com", "subject": "周报", "body": "见附件"}}], "final_contains": ["MSG-6601"], "max_calls": 1}, "dimensions": ["selection", "arguments", "stopping"], "tags": ["lang:zh", "side_effect", "single_shot"]}
